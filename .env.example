APP_NAME="Only in Mongolia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ulaanbaatar
APP_URL=http://localhost

APP_LOCALE=mn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Optional production backend exception reporting.
SENTRY_LARAVEL_DSN=

# MySQL 8.4, like production. Start it with: docker compose -f compose.dev.yaml up -d
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=only_in_mongolia
DB_USERNAME=only_in_mongolia
DB_PASSWORD=local-dev-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production Compose uses Redis for cache. The installer generates its password
# and sets worker concurrency in .env.docker.
# QUEUE_WORKERS=2

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# verify.mn phone login (https://verify.mn). Users text a code to 144773.
VERIFY_MN_API_KEY=
VERIFY_MN_BASE_URL=https://api.verify.mn
VERIFY_MN_USE_CALLBACK=false
# DEV ONLY: comma-separated 8-digit numbers that skip the SMS (ignored in production)
VERIFY_MN_DEV_PHONES=

# QPay payments (https://developer.qpay.mn). Leave empty locally to use the fake "pay (dev)" gateway.
# Sandbox: QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_BASE_URL=https://merchant.qpay.mn/v2
PLATFORM_FEE_PERCENT=20

# Fan wallets (₮): one top-up, and the most a wallet may hold.
MIN_TOPUP=1000
MAX_TOPUP=1000000
MAX_WALLET=3000000

# Admins must turn on two-step sign-in (authenticator app) before opening the admin area.
ADMIN_REQUIRE_2FA=true

# Automatic upload scanning: "none" (blocklist only) or "sightengine" (https://sightengine.com).
MODERATION_DRIVER=none
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Push notifications: make the pair with `php artisan push:keys`. Empty = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Real-time updates (Laravel Reverb). Generate keys with: php artisan reverb:install (or any random strings).
# Run the server with: php artisan reverb:start  (behind your web server/proxy in production, e.g. wss on 443)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Where browsers connect. Leave empty behind the Docker proxy (same address as the site).
# Without a proxy (php artisan serve), point them at Reverb directly:
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=http


# Media storage: "local" (this server) or "r2" (Cloudflare R2, private bucket; downloads cost nothing).
# To switch: fill in R2_*, run `php artisan media:check --disk=r2`, then `php artisan media:copy --to=r2`, then set MEDIA_DISK=r2.
MEDIA_DISK=local
# Set to true to keep serving existing local uploads while new uploads go to R2.
MEDIA_LOCAL_FALLBACK=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Sponsored banners: the email companies write to, to advertise (shown as "Advertise here").
ADS_CONTACT_EMAIL=
# Companies buy banners themselves at /business (paid up front, approved by an admin): price per day in ₮,
# longest campaign, and the longest/largest video banner.
ADS_DAILY_PRICE=20000
ADS_MAX_DAYS=90
ADS_VIDEO_MAX_SECONDS=60
ADS_VIDEO_MAX_MB=100

# Video conversion: every uploaded video becomes a web MP4 (H.264, at most 720p by default) with a still and seek-bar
# frames, on its own queue: run `php artisan queue:work media --queue=media`. Needs ffmpeg; without it videos stay as uploaded.
# Convert videos uploaded earlier with `php artisan media:transcode`.
MEDIA_TRANSCODE=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 1280 = 720p, 1920 = 1080p
MEDIA_VIDEO_MAX_SIDE=1280
MEDIA_VIDEO_CRF=23
MEDIA_VIDEO_MAX_KBPS=4000
MEDIA_TRANSCODE_TIMEOUT=7200
# Adaptive streaming (HLS) for videos at least this long: 360p/540p next to the converted video, in 4 s pieces.
# With MEDIA_DISK=r2, run `php artisan media:cors` once so browsers may load the pieces from the bucket.
MEDIA_HLS=true
MEDIA_HLS_MIN_SECONDS=30

# Receipts for companies (config/billing.php): each paid campaign gets a PDF receipt (prices include VAT).
BILLING_SELLER_NAME="Only in Mongolia ХХК"
BILLING_SELLER_REGISTER=
BILLING_SELLER_ADDRESS="Улаанбаатар хот"
BILLING_SELLER_EMAIL=
BILLING_SELLER_PHONE=
BILLING_SELLER_BANK=
BILLING_VAT_PERCENT=10
# e-barimt through PosAPI 3.0: "none" (PDF only) or "posapi". Values come from your PosAPI registration;
# check them with a test receipt first. `php artisan billing:ebarimt` lists receipts not registered yet (--retry resends).
EBARIMT_DRIVER=none
EBARIMT_POSAPI_URL=http://localhost:7080
EBARIMT_MERCHANT_TIN=
EBARIMT_POS_NO=
EBARIMT_BRANCH_NO=001
EBARIMT_DISTRICT_CODE=
EBARIMT_CLASSIFICATION_CODE=

# Off-site database backups to a second private bucket (from the backup timers; media files aren't copied).
BACKUP_BUCKET=
