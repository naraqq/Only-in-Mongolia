APP_NAME="Only in Mongolia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ulaanbaatar
APP_URL=http://localhost

APP_LOCALE=mn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Optional production backend exception reporting.
SENTRY_LARAVEL_DSN=

# MySQL 8.4, like production. Start it with: docker compose -f compose.dev.yaml up -d
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=only_in_mongolia
DB_USERNAME=only_in_mongolia
DB_PASSWORD=local-dev-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Production Compose uses Redis for cache. The installer generates its password
# and sets worker concurrency in .env.docker.
# QUEUE_WORKERS=2

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# verify.mn phone login (https://verify.mn). Users text a code to 144773.
VERIFY_MN_API_KEY=
VERIFY_MN_BASE_URL=https://api.verify.mn
VERIFY_MN_USE_CALLBACK=false
# DEV ONLY: comma-separated 8-digit numbers that skip the SMS (ignored in production)
VERIFY_MN_DEV_PHONES=

# QPay payments (https://developer.qpay.mn). Leave empty locally to use the fake "pay (dev)" gateway.
# Sandbox: QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_BASE_URL=https://merchant.qpay.mn/v2
PLATFORM_FEE_PERCENT=20

# Fan wallets (₮): one top-up, and the most a wallet may hold.
MIN_TOPUP=1000
MAX_TOPUP=1000000
MAX_WALLET=3000000

# Admins must turn on two-step sign-in (authenticator app) before opening the admin area.
ADMIN_REQUIRE_2FA=true

# Automatic upload scanning: "none" (blocklist only) or "sightengine" (https://sightengine.com).
MODERATION_DRIVER=none
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Push notifications: make the pair with `php artisan push:keys`. Empty = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Real-time updates (Laravel Reverb). Generate keys with: php artisan reverb:install (or any random strings).
# Run the server with: php artisan reverb:start  (behind your web server/proxy in production, e.g. wss on 443)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Where browsers connect. Leave empty behind the Docker proxy (same address as the site).
# Without a proxy (php artisan serve), point them at Reverb directly:
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=http


# Media storage: "local" (this server) or "r2" (Cloudflare R2, private bucket; downloads cost nothing).
# To switch: fill in R2_*, run `php artisan media:check --disk=r2`, then `php artisan media:copy --to=r2`, then set MEDIA_DISK=r2.
MEDIA_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Sponsored banners: the email companies write to, to advertise (shown as "Advertise here").
ADS_CONTACT_EMAIL=
