APP_NAME="Only in Mongolia"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ulaanbaatar
LOG_LEVEL=debug
SITE_ADDRESS=http://localhost
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
DB_DATABASE=only_in_mongolia
DB_USERNAME=only_in_mongolia
DB_PASSWORD=change-this-local-password
# The installer generates this for production. Local Compose does not use it.
REDIS_PASSWORD=
MYSQL_ROOT_PASSWORD=
QUEUE_WORKERS=2
VERIFY_MN_DEV_PHONES=
VERIFY_MN_API_KEY=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
SENTRY_LARAVEL_DSN=
MODERATION_DRIVER=none
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
# Backups (production, see DEPLOYMENT.md): days to keep, and where to copy them off this server.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_FULL_DAYS=56
BACKUP_RSYNC_TARGET=
