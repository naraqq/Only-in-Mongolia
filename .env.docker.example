APP_NAME="Only in Mongolia"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ulaanbaatar
LOG_LEVEL=debug
SITE_ADDRESS=http://localhost
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
DB_DATABASE=only_in_mongolia
DB_USERNAME=only_in_mongolia
DB_PASSWORD=change-this-local-password
# The installer generates this for production. Local Compose does not use it.
REDIS_PASSWORD=
MYSQL_ROOT_PASSWORD=
QUEUE_WORKERS=2
# Real-time updates (Laravel Reverb). The installer generates these for production; these local values are fine locally.
REVERB_APP_ID=only-in-mongolia
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=change-this-local-reverb-secret
# Hostnames allowed to open a real-time connection from a browser (your site's hostname in production; * = any).
REVERB_ALLOWED_ORIGINS=*
VERIFY_MN_DEV_PHONES=
VERIFY_MN_API_KEY=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
SENTRY_LARAVEL_DSN=
MODERATION_DRIVER=none
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
# Backups (production, see DEPLOYMENT.md): days to keep, and where to copy them off this server.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_FULL_DAYS=56
BACKUP_RSYNC_TARGET=
# A second private bucket for backups: every media file nightly (php artisan media:backup) and each database
# dump. Uses the R2 keys unless BACKUP_ACCESS_KEY_ID/BACKUP_SECRET_ACCESS_KEY/BACKUP_ENDPOINT are set (better: another
# Cloudflare account or provider, so one compromised key can't delete both).
BACKUP_BUCKET=

# Media storage: "local" (this server) or "r2" (Cloudflare R2, private bucket; downloads cost nothing).
# To switch: fill in R2_*, run `php artisan media:check --disk=r2`, then `php artisan media:copy --to=r2`, then set MEDIA_DISK=r2.
MEDIA_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Sponsored banners: the email companies write to, to advertise.
ADS_CONTACT_EMAIL=
