{$SITE_ADDRESS} {
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        # Browsers only honour HSTS over HTTPS, so this is harmless on http://localhost.
        Strict-Transport-Security "max-age=31536000"
        # No one may put the site in a frame (clickjacking).
        X-Frame-Options DENY
        Content-Security-Policy "frame-ancestors 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    }
    # Real-time updates: browsers' WebSocket connections go to Reverb.
    handle /app/* {
        reverse_proxy reverb:8080
    }
    # Reverb's event API is only for the app, over the internal network; never from outside.
    handle /apps/* {
        respond 404
    }
    handle {
        encode zstd gzip
        reverse_proxy {
            dynamic a app 80 {
                refresh 5s
                versions ipv4
            }
            lb_policy round_robin
            lb_try_duration 3s
            fail_duration 15s
        }
    }
}

http://:2016 {
    bind 127.0.0.1
    respond /healthz 200
}
